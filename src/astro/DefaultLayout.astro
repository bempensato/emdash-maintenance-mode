---
/**
 * Neutral layout for the maintenance page, used when the integration has no
 * `layout` option: site logo or title, a centered card, light and dark
 * friendly, no external assets.
 */
import { getSiteSettings } from "emdash";
import { createPublicPageContext } from "emdash/page";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";

interface Props {
	title: string;
	content?: { collection: string; id: string; slug?: string | null };
	locale?: string;
}

const { title, content, locale = "en" } = Astro.props;

let siteTitle: string | undefined;
let logo: { url?: string; alt?: string } | undefined;
try {
	const settings = await getSiteSettings();
	siteTitle = settings.title;
	logo = settings.logo?.url ? settings.logo : undefined;
} catch {
	// The page still renders without site identity.
}

const fullTitle = siteTitle && siteTitle !== title ? `${title} — ${siteTitle}` : title;
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: title,
	content,
	siteName: siteTitle,
	seo: { robots: "noindex, nofollow" },
});
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="light dark" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<main class="mm-shell">
			{
				(logo || siteTitle) && (
					<header class="mm-site">
						{logo ? <img src={logo.url} alt={logo.alt || siteTitle || ""} /> : <span>{siteTitle}</span>}
					</header>
				)
			}
			<section class="mm-card">
				<slot />
			</section>
		</main>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>

<style is:global>
	:root {
		--mm-bg: #f6f6f4;
		--mm-card: #ffffff;
		--mm-text: #1d1d1f;
		--mm-border: rgba(0, 0, 0, 0.08);
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--mm-bg: #141416;
			--mm-card: #1e1e21;
			--mm-text: #ececec;
			--mm-border: rgba(255, 255, 255, 0.08);
		}
	}
	html,
	body {
		margin: 0;
		background: var(--mm-bg);
		color: var(--mm-text);
		font-family:
			system-ui,
			-apple-system,
			"Segoe UI",
			Roboto,
			sans-serif;
	}
	.mm-shell {
		min-height: 100vh;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1.5rem;
		padding: 2rem 1rem;
	}
	.mm-site {
		font-size: 1.1rem;
		font-weight: 600;
	}
	.mm-site img {
		display: block;
		max-height: 56px;
		width: auto;
	}
	.mm-card {
		width: 100%;
		max-width: 40rem;
		box-sizing: border-box;
		background: var(--mm-card);
		border: 1px solid var(--mm-border);
		border-radius: 1rem;
		padding: clamp(1.5rem, 5vw, 3rem);
	}
	.mm-card a {
		color: inherit;
	}
</style>
