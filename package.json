{
	"name": "emdash-maintenance-mode",
	"version": "0.2.0",
	"description": "Maintenance mode & coming soon page for EmDash CMS, with live editing, editor bypass and guest access by secret link or password.",
	"license": "SEE LICENSE IN LICENSE.md",
	"author": "Federico Bempensato",
	"homepage": "https://github.com/bempensato/emdash-maintenance-mode#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bempensato/emdash-maintenance-mode.git"
	},
	"bugs": "https://github.com/bempensato/emdash-maintenance-mode/issues",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"astro",
		"maintenance",
		"maintenance-mode",
		"coming-soon",
		"under-construction",
		"prelaunch",
		"password-page",
		"cloudflare-workers"
	],
	"type": "module",
	"packageManager": "pnpm@10.28.0",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs",
		"./astro": "./src/astro/index.ts"
	},
	"files": [
		"dist",
		"src/astro",
		"src/shared",
		"emdash-plugin.jsonc",
		"LICENSE.md"
	],
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit",
		"test": "emdash-plugin validate && vitest run",
		"bundle": "emdash-plugin bundle",
		"login": "emdash-plugin login",
		"publish": "emdash-plugin publish",
		"release:setup": "emdash-plugin release setup"
	},
	"peerDependencies": {
		"astro": ">=7.0.0",
		"emdash": ">=1.1.0"
	},
	"devDependencies": {
		"@emdash-cms/blocks": "1.1.0",
		"@emdash-cms/plugin-cli": "0.13.2",
		"@emdash-cms/plugin-test": "^0.2.7",
		"astro": "^7.3.2",
		"emdash": "^1.1.0",
		"typescript": "^5.9.0",
		"vitest": "^4.1.0",
		"zod": "^4.6.5"
	}
}
